{
  "name": "dsh-mcp",
  "version": "1.14.0-dsh.8",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dshCompatibility": {
    "testedRuntime": "0.2.1-rc.2",
    "policy": "warn"
  },
  "description": "MCP 连接与工具管理：工具开关跨重启持久保存",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "static",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "^4.2.0"
  },
  "author": "Arvin.qi <arvin.qi@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kerberos255/dsh-mcp.git"
  },
  "homepage": "https://github.com/Kerberos255/dsh-mcp",
  "bugs": {
    "url": "https://github.com/Kerberos255/dsh-mcp/issues"
  },
  "dsh": {
    "supported": "0.2.1-rc.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
